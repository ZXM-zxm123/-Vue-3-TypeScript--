# 账单管理系统 - 环境变量配置

# ========================
# 安全配置 (必须设置)
# ========================

# AES-256 加密密钥 (至少32个字符)
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-very-long-and-secure-encryption-key-at-least-32-chars

# JWT 密钥 (用于用户认证)
JWT_SECRET=your-jwt-secret-key-at-least-32-characters

# ========================
# 服务配置
# ========================

# 后端服务端口
PORT=3001

# Python NLP 服务地址
PYTHON_SERVICE_URL=http://localhost:5001

# ========================
# 数据库配置
# ========================

# SQLite 数据库文件路径
# DB_PATH=./data/bills.db

# ========================
# 生产环境建议
# ========================

# 1. 使用 .env 文件存储敏感配置，不要提交到版本控制
# 2. 使用专业的密钥管理服务 (如 AWS Secrets Manager, HashiCorp Vault)
# 3. 定期轮换加密密钥
# 4. 使用 HTTPS 传输敏感数据
# 5. 数据库文件设置适当的文件权限 (chmod 600)
